# Copiá este archivo a ".env" y completá los valores.

# --- Base de datos PostgreSQL ---
DATABASE_URL=postgres://usuario:password@localhost:5432/fixy

# --- Presis  (COMPLETAR con la documentación de Presis) ---
PRESIS_BASE_URL=        # <<< URL base de la API de Presis (ej: https://api.presis.tuempresa.com)
PRESIS_TOKEN=           # <<< token / credencial de acceso a Presis

# --- n8n (opcional) ---
N8N_WEBHOOK_URL=        # webhook que se dispara al confirmar un despacho

# --- Servidor ---
PORT=3001
